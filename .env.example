# Copy this file to .env and fill in what you need. tone_finder.py loads .env
# automatically on startup — no `export` needed. A real shell/OS environment
# variable of the same name always takes precedence over this file (see the
# "Gotcha" note in README.md if a setting here seems to be ignored).

# Required: a TONE3000 server-only Secret Key (starts t3k_cs_, not t3k_pub_).
TONE3000_API_KEY=

# --- This app's own web server ---
# Default: 127.0.0.1:5000 (localhost only). Set HOST=0.0.0.0 to reach it from
# another device on your LAN.
# HOST=127.0.0.1
# PORT=5000

# --- Local LLM server (LM Studio, llama.cpp's llama-server, or mlx-lm) ---
# OpenAI-compatible endpoint. Default: http://127.0.0.1:1234/v1
# LMSTUDIO_BASE=http://127.0.0.1:1234/v1
# Force a specific loaded model instead of auto-picking one. Auto-pick uses
# MLX_MODEL when set (this app launched its own mlx_lm.server, so that's
# already the known-correct choice), else the first model the server's
# /v1/models lists — which for mlx_lm.server can include every model in your
# local Hugging Face cache, not just the one actually loaded, so on mlx-lm
# specifically that fallback is unreliable. Set this explicitly for any other
# server that lists multiple models.
# LMSTUDIO_MODEL=
# Bearer token, only if your server requires one.
# LMSTUDIO_API_TOKEN=
# Set to 1 if a model's thinking channel eats its whole response budget.
# Note: this only works for Qwen3-style templates (enable_thinking); Gemma
# and other "thinking" models may not respond to it at all — see
# LM_JSON_MAX_TOKENS below for a model-agnostic mitigation instead.
# LMSTUDIO_DISABLE_THINKING=
# A "thinking" model can spend most/all of its budget on reasoning before
# answering; too small a budget truncates it mid-thought, which silently
# blanks the guitar/effects suggestion. Raise this (and the timeout) for a
# larger/slower reasoning model.
# LM_JSON_MAX_TOKENS=6000
# LM_JSON_TIMEOUT=180

# --- Auto-launch mlx-lm instead of requiring a server already running (Apple Silicon) ---
# Local path or Hugging Face repo id. Leave unset to use LMSTUDIO_BASE as-is.
# MLX_MODEL=mlx-community/Qwen3-8B-4bit
# MLX_HOST=127.0.0.1
# MLX_PORT=8080
# Seconds to wait for mlx_lm.server to become ready (a first run also downloads weights).
# MLX_STARTUP_TIMEOUT=300
# Point at an isolated venv's mlx_lm.server if this machine's transformers is
# too old for mlx-lm (e.g. ./.venv-mlx/bin/mlx_lm.server).
# MLX_SERVER_BIN=
# How many distinct-prompt KV caches mlx_lm.server keeps resident at once
# (its own default is 10). Each one is sized to that request's full context,
# so a high value can look like "memory is never released" in Activity
# Monitor — it's MLX's pinned GPU working set, not a leak. Lower further if
# you still see this; raise it only if you need more than a couple of very
# different prompt shapes cached simultaneously.
# MLX_PROMPT_CACHE_SIZE=2

# --- Optional web research (DuckDuckGo via the ddgs package, no API key needed) ---
# Number of search results to fetch per research call.
# DDG_RESULTS=5
# Timeout (seconds) for the search call.
# WEB_RESEARCH_TIMEOUT=30
